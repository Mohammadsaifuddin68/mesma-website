rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Blog media — public read, authenticated upload with permission
    match /blog-media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Featured images — same as blog-media
    match /featured-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
