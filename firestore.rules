rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user is an active admin
    function isActiveAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Function to get user permissions
    function hasPermission(permission) {
      return isActiveAdmin() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' || 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[permission] == true
      );
    }

    // Leads collection
    match /leads/{leadId} {
      // Public can submit contact forms
      allow create: if true;
      
      // Only admins with viewLeads permission can read
      allow read: if hasPermission('viewLeads');
      
      // Only admins with editLeadStatus permission can update
      allow update: if hasPermission('editLeadStatus');
      
      // Deleting leads is not explicitly required, but if needed:
      allow delete: if hasPermission('editLeadStatus');
    }

    // Admins collection
    match /admins/{adminId} {
      // Temporarily allow anyone to create their own admin profile (for the initial Super Admin script)
      // We will restrict this after creation.
      allow create: if request.auth != null && request.auth.uid == adminId;

      // Admins with manageAdmins can read all, others can read their own
      allow read: if hasPermission('manageAdmins') || (request.auth != null && request.auth.uid == adminId);
      
      // Only admins with manageAdmins can update other users. Users can't update their own permissions.
      allow update: if hasPermission('manageAdmins');
      allow delete: if hasPermission('deleteAdmins');
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      // Any active admin can write logs (the system creates them)
      allow create: if isActiveAdmin();
      
      // Only admins with auditLogs permission can read them
      allow read: if hasPermission('auditLogs');
      
      allow update, delete: if false; // Logs are immutable
    }
    
  }
}
