rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data 
        : null;
    }

    function isActiveAdmin() {
      return getAdminData() != null && getAdminData().active == true;
    }

    function hasPermission(permission) {
      return isActiveAdmin() && (
        getAdminData().role == 'super_admin' || 
        getAdminData().permissions[permission] == true
      );
    }

    // ── Leads ────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow create: if true;
      allow read:   if hasPermission('viewLeads');
      allow update: if hasPermission('editLeadStatus');
      allow delete: if hasPermission('editLeadStatus');
    }

    // ── Admins / Editors ─────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow create: if request.auth != null && request.auth.uid == adminId;
      allow read:   if hasPermission('manageAdmins') || (request.auth != null && request.auth.uid == adminId);
      allow update: if hasPermission('manageAdmins');
      allow delete: if hasPermission('deleteAdmins');
    }

    // ── Audit Logs ───────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if isActiveAdmin();
      allow read:   if hasPermission('auditLogs');
      allow update, delete: if false;
    }

    // ── Blogs ────────────────────────────────────────────────────────────────
    match /blogs/{blogId} {
      // Public can read published posts, Admins can read all
      allow read: if hasPermission('viewBlogDashboard') || resource.data.status == 'published';

      // Editors can create if they have createBlog permission
      allow create: if hasPermission('createBlog');

      // Editors can update their own posts, or others' if they have manageOthersPosts
      allow update: if hasPermission('editBlog') && (
        resource.data.authorId == request.auth.uid || hasPermission('manageOthersPosts')
      );

      // Delete requires deleteBlog permission
      allow delete: if hasPermission('deleteBlog') && (
        resource.data.authorId == request.auth.uid || hasPermission('manageOthersPosts')
      );
    }

    // ── Blog Categories ──────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasPermission('manageCategories');
    }

    // ── Blog Tags ────────────────────────────────────────────────────────────
    match /tags/{tagId} {
      allow read: if true;
      allow write: if hasPermission('manageTags');
    }
    
  }
}
